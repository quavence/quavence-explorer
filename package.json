{
  "name": "quavence-explorer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "kill-port": "node scripts/kill-port.cjs 3039",
    "kill-dev-procs": "node scripts/kill-dev-procs.cjs",
    "kill-dev-ports": "node scripts/kill-port.cjs 3039 && node scripts/kill-port.cjs 5173",
    "clean-dev": "npm run kill-dev-procs && npm run kill-dev-ports",
    "dev": "npm run clean-dev && concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "api:dev": "tsx watch src/api/server.ts",
    "web:dev": "wait-on tcp:127.0.0.1:3039 && vite --host 127.0.0.1",
    "indexer": "tsx src/indexer/indexer.ts",
    "reindex": "tsx src/indexer/indexer.ts --reindex",
    "copy-schema": "node scripts/copy-schema.cjs",
    "build": "tsc && npm run copy-schema && vite build",
    "prestart": "npm run kill-port && npm run build",
    "test": "tsx scripts/test_indexer_invariants.ts && tsx scripts/test_carrier_lineage.ts && tsx scripts/test_lineage_security.ts && tsx scripts/test_lineage_anti_spoofing.ts && tsx scripts/test_protocol_opcodes.ts && tsx scripts/test_glyph_rarity_filter.ts && tsx scripts/test_attestation_taxonomy.ts && tsx scripts/test_lsa_state_sync_indexer.ts && tsx scripts/test_cache_and_rollback.ts && tsx scripts/test_glyph_service_and_status.ts && tsx scripts/test_collection_isolation.ts && tsx scripts/test_adversarial_deep_probe.ts",
    "test:invariants": "tsx scripts/test_indexer_invariants.ts",
    "test:lineage": "tsx scripts/test_carrier_lineage.ts",
    "test:security": "tsx scripts/test_lineage_security.ts",
    "test:isolation": "tsx scripts/test_collection_isolation.ts",
    "test:anti-spoofing": "tsx scripts/test_lineage_anti_spoofing.ts",
    "test:opcodes": "tsx scripts/test_protocol_opcodes.ts",
    "test:rarity": "tsx scripts/test_glyph_rarity_filter.ts",
    "test:taxonomy": "tsx scripts/test_attestation_taxonomy.ts",
    "test:lsa": "tsx scripts/test_lsa_state_sync_indexer.ts",
    "test:rollback": "tsx scripts/test_cache_and_rollback.ts",
    "test:service": "tsx scripts/test_glyph_service_and_status.ts",
    "test:deep-probe": "tsx scripts/test_adversarial_deep_probe.ts"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "wait-on": "^9.0.10"
  }
}
